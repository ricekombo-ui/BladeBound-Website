# Supabase — get these from your project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: used server-side for privileged operations (service role — keep secret)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Isolated beta Supabase project (public client values, not AMC and not service-role).
NEXT_PUBLIC_BETA_SUPABASE_URL=
NEXT_PUBLIC_BETA_SUPABASE_ANON_KEY=
